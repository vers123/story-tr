# 复制为 .env 并填写（.env 不入库）
# 三个后端「优先官方 API，未配 key 时回退免费通道」

# Google Cloud Translation v2（官方 API，需申请 key）
# - 填了 → 走官方 API（稳定、有配额、支持长文本）
# - 没填 → 走 clients5.google.com 免 key 端点
GOOGLE_API_KEY=

# Bing / Microsoft Translator（Azure 官方 API，需申请 key）
# - 填了 → 走 Azure 官方接口
# - 没填 → 走 Bing 网页免 key 通道（www.bing.com / cn.bing.com）
BING_API_KEY=
BING_REGION=

# 百度翻译开放平台（官方 API，需 APPID + 密钥）
BAIDU_APPID=
BAIDU_APPKEY=

# Bing 网页通道域名（可选，逗号分隔；默认 cn.bing.com,www.bing.com）
BING_WEB_BASE=

# 代理（可选；也可用命令行 --proxy 覆盖）
HTTPS_PROXY=
HTTP_PROXY=
