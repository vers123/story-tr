# 复制为 .env 并填写（.env 不入库）
# 三个后端「优先官方 API，未配 key 时回退免费通道」

# 工作目录（可选）：data/ logs/ out/ .env 的根目录；
# 不设则向上查找 data/character.json，最后用当前目录
STORY_TR_HOME=

# Google Cloud Translation v2（官方 API，需申请 key）
# - 填了 → 走官方 API（稳定、有配额、支持长文本）
# - 没填 → 走 clients5.google.com 免 key 端点
GOOGLE_API_KEY=

# Bing / Microsoft Translator（Azure 官方 API，需申请 key）
# - 填了 → 走 Azure 官方接口
# - 没填 → 走 Bing 网页免 key 通道（www.bing.com / cn.bing.com）
BING_API_KEY=
BING_REGION=

# 百度翻译开放平台（官方 API，需 APPID + 密钥）
BAIDU_APPID=
BAIDU_APPKEY=

# 代理（可选；经 HTTPS_PROXY / HTTP_PROXY 环境变量）
HTTPS_PROXY=
HTTP_PROXY=

# 本地 RWKV（RWKV-Runner，可选；`--mode rwkv20` 一次成型使用）
# 通过 RWKV-Runner 的 OpenAI 兼容接口调用，模型需先在 Runner 中加载
RWKV_API_URL=http://127.0.0.1:8000
# 提示词模板：占位符支持 {text} / {src} / {tgt}；\n 会按换行解析
RWKV_PROMPT_TEMPLATE=User: {text}\n\nBot:
RWKV_MAX_TOKENS=1024
RWKV_TEMPERATURE=1.0
RWKV_TOP_P=0.3
RWKV_TIMEOUT=300
RWKV_CHUNK_CHARS=1200
RWKV_RETRIES=2
# 模型通常放在 RWKV-Runner 的 models/ 下，此项仅用于 status/doctor 检查文件是否存在
RWKV_MODEL_PATH=
